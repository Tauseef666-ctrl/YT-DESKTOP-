# Normalize to LF in the repo; Windows checkouts get CRLF only where required.
* text=auto eol=lf

# Batch files must be CRLF to run correctly on Windows.
*.bat text eol=crlf
gradlew text eol=lf

# Binaries — never line-ending mangled.
*.jar binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.ico binary